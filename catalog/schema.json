{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Catalog entry metadata",
  "description": "Machine-readable sidecar for README catalog entries. The README stays hand-written; scripts/check-catalog.py checks that every entry here matches a README link and that metadata is well-formed.",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "sections"],
  "properties": {
    "version": {"type": "string"},
    "sections": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["heading", "entries"],
        "properties": {
          "heading": {"type": "string", "minLength": 1, "description": "README heading text without the leading emoji."},
          "entries": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["name", "url", "kind", "license", "deployment", "input_types", "last_checked", "status"],
              "properties": {
                "name": {"type": "string", "minLength": 1},
                "url": {"type": "string", "pattern": "^https://"},
                "kind": {"enum": ["library", "model", "service", "dataset", "tool", "list", "tutorial"]},
                "license": {"type": "string", "description": "SPDX id from the canonical repo, 'Proprietary', or 'unverified'."},
                "deployment": {"enum": ["local", "hosted", "both"]},
                "input_types": {"type": "array", "minItems": 1, "items": {"enum": ["plain_text", "text_pdf", "scanned_pdf", "image", "docx", "html", "office"]}},
                "ocr": {"enum": ["none", "built_in", "optional", "external"]},
                "last_checked": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"},
                "status": {"enum": ["active", "maintenance", "archived", "unclear"]},
                "notes": {"type": "string"}
              }
            }
          }
        }
      }
    }
  }
}
