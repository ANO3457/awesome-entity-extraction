{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Runnable example metadata",
  "description": "One example.json per examples/<NN-slug>/ folder. Checked offline by scripts/check-examples.py, which also generates examples/README.md from these files.",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "title", "summary", "task", "stack", "input_type", "languages", "runs_locally",
               "needs_api_key", "needs_gpu", "downloads_model", "needs_network", "models"],
  "properties": {
    "id": {"type": "string", "pattern": "^[0-9]{2}-[a-z0-9-]+$", "description": "Must equal the folder name."},
    "title": {"type": "string", "minLength": 1},
    "summary": {"type": "string", "minLength": 1, "description": "One line for the generated examples index."},
    "task": {"type": "string", "minLength": 1},
    "stack": {"type": "string", "minLength": 1},
    "input_type": {"enum": ["plain_text", "text_pdf", "scanned_image", "html", "conversation", "transcript", "spreadsheet"]},
    "languages": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "runs_locally": {"type": "boolean"},
    "needs_api_key": {"type": "boolean"},
    "needs_gpu": {"type": "boolean"},
    "downloads_model": {"type": "boolean"},
    "needs_network": {"type": "boolean"},
    "models": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "publisher", "license"],
        "properties": {
          "name": {"type": "string"},
          "publisher": {"type": "string"},
          "license": {"type": "string", "description": "SPDX id, 'Proprietary API', or 'unverified'."},
          "base_model": {"type": "string", "description": "Upstream base model, if the model is a fine-tune."}
        }
      }
    }
  }
}
